{
  "name": "ai-office",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/office-ui/tsconfig.json",
    "sim": "npm run sim -w @ai-office/orchestrator",
    "smoke": "npm run smoke -w @ai-office/orchestrator --",
    "build:screen": "npm run build -w @ai-office/office-ui",
    "demo:screen": "npm run demo:screen -w @ai-office/orchestrator",
    "lint:ds": "node packages/orchestrator/src/design/ds-lint-cli.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
