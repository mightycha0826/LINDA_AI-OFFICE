          "value": "\"tickets\".\"paused_from\" IS NULL OR (\"tickets\".\"paused_from\" <> 'paused' AND \"tickets\".\"paused_from\" IN ('planned', 'in_progress', 'in_review', 'rework', 'meeting', 'blocked', 'awaiting_approval', 'done', 'cancelled', 'paused'))"
